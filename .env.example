# Local: use ignored .env. Hosting: use server secret environment variables only.
REALITY_DEFENDER_API_KEY=
GROQ_API_KEY=
# Fixture mode never contacts providers. Live mode never falls back to fixtures.
REALCHECK_MODE=fixture
PORT=3000
# Optional public extension ID. Empty disables cross-origin side-panel access.
# Local panel default: 127.0.0.1:3001; hosted build: https://realchecknow.xyz.
REALCHECK_EXTENSION_ID=

# Hosting only. Leave origin empty for loopback development.
REALCHECK_PUBLIC_ORIGIN=
# HOST defaults to 127.0.0.1 locally, 0.0.0.0 with a public origin.
HOST=
REALCHECK_PUBLIC_LIVE_ENABLED=false
# Hosting only: Upstash Redis Free REST credentials (server secrets).
# Run quota verification/initialization before enabling hosted live checks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REALCHECK_DAILY_LIMIT=20
REALCHECK_HOURLY_LIMIT=5
# Extension build-time selection only; never a provider key.
REALCHECK_EXTENSION_BACKEND=http://127.0.0.1:3001
